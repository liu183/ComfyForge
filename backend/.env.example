# ===== Comfy Service 配置 =====

# 服务监听
COMFY_SERVICE_HOST=0.0.0.0
COMFY_SERVICE_PORT=8000

# ComfyUI 节点：支持多个，逗号分隔；格式 name=url
# 本地节点与远程节点均可，任意可达即作为主节点
COMFY_SERVERS=local=http://127.0.0.1:8188

# 任务轮询间隔（秒）
COMFY_POLL_INTERVAL=1.0

# 强制所有能力走模拟模式（演示/无模型环境）
# COMFY_FORCE_MOCK=true

# 云端 API 节点密钥（配置后 txt2video/img2video 可走 Wan 云端节点）
# WAN_API_KEY=

{
  "type": "txt2video",
  "label": "文生视频",
  "description": "根据文字提示词生成一段短视频（MiniMax H3，含原生音频）",
  "accepts_image": false,
  "backend_order": ["comfy_h3", "comfy_local", "comfy_api"],
  "params": [
    {"name": "prompt", "label": "提示词", "type": "text", "required": true, "description": "建议按「场景与氛围 → 动作与镜头 → 声音」三段式描述（H3 原生支持带声视频）"},
    {"name": "negative_prompt", "label": "负面提示词", "type": "text", "default": "", "description": "H3 暂不支持负面提示词，可留空"},
    {"name": "width", "label": "宽度", "type": "int", "default": 640, "min": 128, "max": 2048, "description": "需为 32 的倍数"},
    {"name": "height", "label": "高度", "type": "int", "default": 352, "min": 128, "max": 2048, "description": "需为 32 的倍数"},
    {"name": "length", "label": "帧数", "type": "int", "default": 124, "min": 9, "max": 1000, "description": "总帧数（124 帧 ≈ 5 秒 @24fps）"},
    {"name": "steps", "label": "步数", "type": "int", "default": 4, "min": 1, "max": 60},
    {"name": "cfg", "label": "CFG", "type": "float", "default": 3.0, "min": 1.0, "max": 12.0},
    {"name": "fps", "label": "帧率", "type": "int", "default": 24, "min": 1, "max": 60},
    {"name": "seed", "label": "随机种子", "type": "int", "default": 0, "description": "-1 表示随机"}
  ],
  "backends": {
    "comfy_local": {
      "requires_nodes": ["UNETLoader", "CLIPLoader", "VAELoader", "CLIPTextEncode", "EmptyLTXVLatentVideo", "LTXVConditioning", "ModelSamplingLTXV", "LTXVScheduler", "KSampler", "VAEDecode", "SaveVideo"],
      "requires_models": [
        {"loader": "UNETLoader", "field": "unet_name"},
        {"loader": "CLIPLoader", "field": "clip_name"},
        {"loader": "VAELoader", "field": "vae_name"}
      ],
      "output_node": "12",
      "output_kind": "video",
      "note": "本地 LTXV 文生视频，需下载 ltxv 系列模型（unet/clip/vae）到对应目录",
      "workflow": {
        "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "$model", "weight_dtype": "default"}},
        "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "$model", "type": "ltxv"}},
        "3": {"class_type": "VAELoader", "inputs": {"vae_name": "$model"}},
        "4": {"class_type": "CLIPTextEncode", "inputs": {"text": "$prompt", "clip": ["2", 0]}},
        "5": {"class_type": "CLIPTextEncode", "inputs": {"text": "$negative_prompt", "clip": ["2", 0]}},
        "6": {"class_type": "EmptyLTXVLatentVideo", "inputs": {"width": "$width", "height": "$height", "length": "$length", "batch_size": 1}},
        "7": {"class_type": "LTXVConditioning", "inputs": {"positive": ["4", 0], "negative": ["5", 0], "frame_rate": "$fps"}},
        "8": {"class_type": "ModelSamplingLTXV", "inputs": {"model": ["1", 0], "max_shift": 2.05, "base_shift": 0.95}},
        "9": {"class_type": "LTXVScheduler", "inputs": {"steps": "$steps", "max_shift": 2.05, "base_shift": 0.95, "stretch": true, "terminal": 0.1}},
        "10": {"class_type": "KSampler", "inputs": {"model": ["8", 0], "positive": ["7", 0], "negative": ["7", 1], "latent_image": ["6", 0], "seed": "$seed", "steps": "$steps", "cfg": "$cfg", "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0, "sigmas": ["9", 0]}},
        "11": {"class_type": "VAEDecode", "inputs": {"samples": ["10", 0], "vae": ["3", 0]}},
        "12": {"class_type": "SaveVideo", "inputs": {"video": ["11", 0], "filename_prefix": "comfy-service/txt2video", "format": "auto", "codec": "h264"}}
      }
    },
    "comfy_h3": {
      "requires_nodes": ["UNETLoader", "VAELoader", "ClipProjLoader", "LoraLoaderModelOnly", "MiniMaxH3ImageToVideo", "MiniMaxH3SigmaShift", "BasicGuider", "BasicScheduler", "KSamplerSelect", "RandomNoise", "SamplerCustomAdvanced", "VAEDecode", "VAEDecodeAudio", "CreateVideo", "SaveVideo"],
      "requires_models": [
        {"loader": "UNETLoader", "field": "unet_name", "match": ["minimax_h3"]},
        {"loader": "ClipProjLoader", "field": "clip_name", "match": ["qwen3vl"]},
        {"loader": "VAELoader", "field": "vae_name", "match": ["minimax_h3"]}
      ],
      "output_node": "15",
      "output_kind": "video",
      "note": "MiniMax H3-Lite 文生视频（W4A8 低显存路线，640x352/124帧/4步，含原生音频）",
      "workflow": {
        "1": {"class_type": "ClipProjLoader", "inputs": {"mode": "dynamic", "projection": "mmh3-4b-ClipProj-celeb-mlp.safetensors", "device": "cuda:0", "clip_name": "qwen3vl_4b_int4_convrot.safetensors", "type": "krea2"}},
        "2": {"class_type": "UNETLoader", "inputs": {"weight_dtype": "default", "unet_name": "minimax_h3_fl2va_pruned_w4a8_mixed_ax1y2jp.safetensors"}},
        "3": {"class_type": "MiniMaxH3SigmaShift", "inputs": {"shift_video": 12.0, "shift_audio": 3.0, "model": ["2", 0]}},
        "4": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}},
        "5": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
        "6": {"class_type": "MiniMaxH3ImageToVideo", "inputs": {"clip": ["1", 0], "width": "$width", "prompt": "$prompt", "vae": ["4", 0], "length": "$length", "height": "$height"}},
        "7": {"class_type": "BasicGuider", "inputs": {"model": ["105:201", 0], "conditioning": ["6", 0]}},
        "8": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "res_multistep"}},
        "9": {"class_type": "BasicScheduler", "inputs": {"scheduler": "simple", "model": ["105:201", 0], "steps": "$steps", "denoise": 1.0}},
        "10": {"class_type": "RandomNoise", "inputs": {"noise_seed": "$seed"}},
        "11": {"class_type": "SamplerCustomAdvanced", "inputs": {"sigmas": ["9", 0], "guider": ["7", 0], "noise": ["10", 0], "sampler": ["8", 0], "latent_image": ["6", 1]}},
        "12": {"class_type": "VAEDecode", "inputs": {"samples": ["11", 0], "vae": ["4", 0]}},
        "13": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["11", 0], "vae": ["5", 0]}},
        "14": {"class_type": "CreateVideo", "inputs": {"images": ["12", 0], "audio": ["13", 0], "bit_depth": 8, "fps": "$fps"}},
        "15": {"class_type": "SaveVideo", "inputs": {"video": ["14", 0], "filename_prefix": "comfy-service/txt2video", "format": "auto", "codec": "auto"}},
        "105:201": {"class_type": "LoraLoaderModelOnly", "inputs": {"strength_model": 1.0, "model": ["3", 0], "lora_name": "minimax_h3_fl2v_lightx2v_turbo_4step_v0.1_comfy_resized_avg_rank_21_bf16.safetensors"}}
      }
    },
    "comfy_api": {
      "node_type": "WanTextToVideoApi",
      "requires_key": "wan_api_key",
      "output_kind": "video",
      "workflow": {
        "1": {"class_type": "WanTextToVideoApi", "inputs": {"model": "wan2.6-t2v", "prompt": "$prompt", "negative_prompt": "$negative_prompt", "size": "480p: 16:9 (832x480)", "duration": "5", "seed": "$seed"}}
      }
    }
  }
}
